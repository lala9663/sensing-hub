# 워커 로컬 전용 설정 예시. 이 파일을 같은 폴더에 worker.local.env 로 복사해 값을 채운다.
# worker.local.env 는 .gitignore에 들어 있어 커밋되지 않는다. 키를 채팅이나 커밋에 붙이지 않는다.
# run-worker.ps1 이 시작할 때 읽는다 (이미 설정된 환경 변수는 덮어쓰지 않는다). 형식: KEY=VALUE, # 뒤는 주석.
# run-backend.ps1 도 이 파일의 SENSING_LLM_*·SENSING_EMBED_*·ANTHROPIC_* 값만 읽어 챗봇에 쓴다 (LLM·임베딩 설정을 한 곳에서 관리).
# 바꾼 뒤에는 워커·백엔드를 재시작해야 반영된다.

# ---- LLM (요약·분류, 등록 시 레시피) — 아래 셋 중 하나만 # 를 지워 채운다 ----

# (1) Google Gemini 무료 등급 — 2026-10-19 로컬 실측에 쓴 설정. 키: aistudio.google.com 의 "Get API key" (카드 불필요)
#     OpenAI 호환 주소로 붙는다. 무료 한도는 모델별·하루 단위라 Flash-Lite를 권한다:
#       gemini-3.5-flash-lite  하루 약 500회 (실측: 30건 묶음으로 문서 7,967건을 오류 없이 처리)
#       gemini-3.8-flash       분류가 조금 더 정확하지만 하루 20회뿐 (금방 HTTP 429)
#       gemini-2.5-flash 등 옛 모델은 신규 사용자에게 404 — 모델 목록은 {BASE_URL}/models 로 확인
#     무료 등급은 보낸 내용이 Google 모델 개선에 쓰일 수 있다 (수집 기사는 공개 뉴스지만 회사 규정 확인).
#SENSING_LLM_PROVIDER=openai
#SENSING_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#SENSING_LLM_MODEL=gemini-3.5-flash-lite
#SENSING_LLM_API_KEY=

# (2) Claude API — console.anthropic.com > Settings > API Keys 에서 만든 키 (sk-ant-api03- 로 시작, 사용량만큼 과금)
#SENSING_LLM_PROVIDER=anthropic
#ANTHROPIC_API_KEY=
#SENSING_LLM_MODEL=claude-opus-5-5

# (3) 사내 OpenAI 호환 게이트웨이 (vLLM·Ollama 등)
#SENSING_LLM_PROVIDER=openai
#SENSING_LLM_BASE_URL=http://gateway.example.internal/v1
#SENSING_LLM_MODEL=
#SENSING_LLM_API_KEY=

# ---- 의미 검색 임베딩 (챗봇 문서 검색, 큐가 빌 때 워커가 색인된 조각을 한 묶음씩) ----
# 워커가 문서 조각을, 백엔드가 질의를 같은 설정으로 임베딩한다. BASE_URL·API_KEY를 비우면 위 SENSING_LLM_BASE_URL·API_KEY를 함께 쓴다.
# Gemini 무료 등급은 묶음 안의 글 하나를 요청 하나로 세어 분당 100개까지만 받는다 (2026-10-19 실측) — 기본값(20개 묶음, 분당 80개)이 맞춰져 있다.
# 하루 한도도 있어 쌓인 조각 전부(수천 건)를 한 번에 채우기는 어렵다 — 유휴 시간에 조금씩 채워진다.
#SENSING_EMBED_PROVIDER=openai
#SENSING_EMBED_MODEL=gemini-embedding-001
#SENSING_EMBED_BATCH=20
#SENSING_EMBED_PER_MINUTE=80

# ---- 네이버 뉴스 검색 (NAVER API HUB) — 워커·백엔드가 함께 읽는다 ----
# 키 값은 여기에 두지 않는다: 관리자 화면 'API 키'에서 naver_news(Client ID·Client Secret)로 넣는다.
# display(기본) = 표시 전용: 감시 화면에서 실시간으로 보여 주기만 하고 저장·요약·챗봇에 쓰지 않는다 (2026-09-07 개정 약관).
# store = 저장·분석: 법무 확인 뒤에만 켠다. off = 쓰지 않는다.
#SENSING_NAVER_MODE=display
# hub(기본) | developers(예전 개발자센터 키가 있을 때만, 2027-06-30 지원 종료)
#SENSING_NAVER_API=hub

# ---- 자동 요약·분류 (큐가 빌 때 워커가 한 묶음씩) ----
# 처음엔 false로 두고 소량으로 품질·비용을 본 뒤 true로 켠다
SENSING_ENRICH_ENABLED=false
# 한 번 호출에 보내는 문서 수. 무료 등급은 하루·분당 "호출 수"가 병목이라 크게 둔다 (기본 10)
#SENSING_ENRICH_BATCH=30

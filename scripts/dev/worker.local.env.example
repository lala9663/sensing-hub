# 워커 로컬 전용 설정 예시. 이 파일을 같은 폴더에 worker.local.env 로 복사해 값을 채운다.
# worker.local.env 는 .gitignore에 들어 있어 커밋되지 않는다. 키를 채팅이나 커밋에 붙이지 않는다.
# run-worker.ps1 이 시작할 때 읽는다 (이미 설정된 환경 변수는 덮어쓰지 않는다). 형식: KEY=VALUE, # 뒤는 주석.

# ---- LLM (요약·분류, 등록 시 레시피) — 둘 중 하나만 채운다 ----
# Claude API
#SENSING_LLM_PROVIDER=anthropic
#ANTHROPIC_API_KEY=
#SENSING_LLM_MODEL=claude-opus-5-5

# 사내 OpenAI 호환 게이트웨이 (vLLM·Ollama 등)
#SENSING_LLM_PROVIDER=openai
#SENSING_LLM_BASE_URL=http://gateway.example.internal/v1
#SENSING_LLM_MODEL=
#SENSING_LLM_API_KEY=

# 큐가 빌 때 자동으로 도는 요약·분류. 처음엔 꺼 두고 소량으로 품질·비용을 본 뒤 켠다
SENSING_ENRICH_ENABLED=false
